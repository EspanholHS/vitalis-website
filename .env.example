# Public Supabase configuration. Safe to expose to the browser; data access is
# still enforced by Supabase Auth and Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional: public origin used in confirmation links (defaults to the request origin).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
